# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Realtime Database Admin SDK Config (use Service Account JSON, stored as encrypted secrets)
FIREBASE_RTDB_URL="MY_FIREBASE_RTDB_URL"
FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
# Either paste the full Service Account JSON string into FIREBASE_SERVICE_ACCOUNT_JSON,
# or point FIREBASE_SERVICE_ACCOUNT_PATH to your local gitignored *-firebase-adminsdk-*.json file:
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_SERVICE_ACCOUNT_PATH=""
# Optional legacy fallback only (deprecated by Firebase):
# FIREBASE_DB_SECRET=""
